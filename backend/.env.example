APP_ENV=development
ADMIN_PASSWORD=change-this-local-password
ENCRYPTION_KEY=replace-with-generated-fernet-key
DATABASE_URL=sqlite+aiosqlite:///./data/studio.db
DATA_DIR=./data
FRONTEND_ORIGIN=http://localhost:5173
GENERATION_MODE=local
DEMO_MODE=false
LOCAL_TTS_ENGINE=espeak
# Optional neural speech: install requirements-loudkit.txt and pre-download the model.
LOUDKIT_MODEL=loudreader/loudr-1
LOUDKIT_REVISION=v0.1.1
# Optional server-side defaults; UI keys take precedence.
# Cloud environment settings use STUDIO_OPENAI_API_KEY; OPENAI_API_KEY remains supported locally.
STUDIO_OPENAI_API_KEY=
DID_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Restrict downloaded D-ID output to these exact hosts or their subdomains.
MEDIA_HOSTS=d-id.com,amazonaws.com,cloudfront.net
